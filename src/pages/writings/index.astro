---
import BaseLayout from "@layouts/BaseLayout.astro"
import Prose from "@components/common/Prose.astro"
import WritingCard from "@components/section/writings/WritingCard.astro"
import { getWritings } from "@utils/getContent"

const {
  title = "Статті",
  description = "Архів статей і нотаток.",
} = Astro.props

const writingEntries = await getWritings()
const pinnedEntries = writingEntries.filter((entry) => entry.data.pinned)
const regularEntries = writingEntries.filter((entry) => !entry.data.pinned)
---

<BaseLayout title={title} description={description}>
  <Prose>
    {
      pinnedEntries.length > 0 && (
        <>
          <h1>Закріплені статті</h1>
          <div class="not-prose flex flex-col gap-y-2">
            {pinnedEntries.map((writingEntry) => (
              <WritingCard writingEntry={writingEntry} />
            ))}
          </div>
        </>
      )
    }

    <h1 class="mt-8!">Статті</h1>
    <div class="not-prose flex flex-col gap-y-2">
      {
        regularEntries.map((writingEntry) => (
          <WritingCard writingEntry={writingEntry} />
        ))
      }
    </div>
  </Prose>
</BaseLayout>
