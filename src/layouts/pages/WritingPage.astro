---
import BaseLayout from "@layouts/BaseLayout.astro"
import Prose from "@components/common/Prose.astro"
import PostTags from "@components/common/PostTags.astro"
import Back from "@components/common/Back.astro"
import { formatDate } from "@utils/formatDate"

const { frontmatter, readingTime } = Astro.props
const { title, description, date, tags } = frontmatter.data

const formattedDate = formatDate(date, "long")
---

<BaseLayout title={title} description={description}>
  <Prose>
    <h1>{title}</h1>

    <div class="-mt-4 mb-8 space-x-2 text-sm text-muted-foreground">
      <time datetime={date}>{formattedDate}</time>
      <span>&middot;</span>
      <span>{readingTime}</span>
    </div>

    <slot />

    <PostTags tags={tags} />

    <Back label="До всіх статей" href="/" class="mt-8" />
  </Prose>
</BaseLayout>

<script>
  async function renderMermaidDiagrams() {
    const codeBlocks = Array.from(
      document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]')
    )

    if (codeBlocks.length === 0) return

    const diagrams = codeBlocks.map((codeBlock) => {
      const lines = Array.from(
        codeBlock.querySelectorAll<HTMLElement>(".ec-line .code")
      )
      const source =
        lines.length > 0
          ? lines.map((line) => line.textContent ?? "").join("\n")
          : (codeBlock.textContent ?? "")

      const diagram = document.createElement("div")
      diagram.className = "mermaid not-prose my-8 overflow-x-auto"
      diagram.textContent = source

      const expressiveCodeFrame = codeBlock.closest("figure")
      ;(expressiveCodeFrame ?? codeBlock).replaceWith(diagram)

      return diagram
    })

    const { default: mermaid } = await import("mermaid")
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "default",
    })

    await mermaid.run({ nodes: diagrams })
  }

  document.addEventListener("astro:page-load", renderMermaidDiagrams)

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", renderMermaidDiagrams, {
      once: true,
    })
  } else {
    void renderMermaidDiagrams()
  }
</script>

<style is:global>
  .mermaid svg {
    height: auto;
    max-width: 100%;
  }
</style>
