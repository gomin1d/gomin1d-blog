---
import { config } from "@parseConfig"
import { getWritings } from "@utils/getContent"

const navMenu = config.navigation
const writingEntries = await getWritings()

const currentPath = Astro.url.pathname
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href)
---

<aside class="min-w-0 md:sticky md:top-0 md:h-screen md:min-h-0">
  <nav
    class="flex flex-wrap items-center gap-x-6 gap-y-1 border-b border-border/50 py-4 md:mt-8 md:max-h-[calc(100vh-4rem)] md:w-full md:min-w-0 md:flex-col md:flex-nowrap md:items-stretch md:overflow-x-hidden md:overflow-y-auto md:border-r md:border-b-0 md:py-0 md:pr-5"
  >
    {
      navMenu.map((nav) => (
        <a
          href={nav.href}
          class:list={[
            "py-0.5 text-muted-foreground transition-colors duration-200 ease-out hover:text-foreground",
            isActive(nav.href) &&
              "font-medium text-foreground! underline decoration-muted-foreground/50 underline-offset-2 hover:decoration-muted-foreground",
          ]}
        >
          {nav.label}
        </a>
      ))
    }

    <div
      class="mt-3 hidden min-w-0 border-t border-border/50 pt-3 md:flex md:w-full md:flex-col md:gap-y-1"
    >
      {
        writingEntries.map((writingEntry) => {
          const href = `/${writingEntry.collection}/${writingEntry.id}`

          return (
            <a
              href={href}
              title={writingEntry.data.title}
              class:list={[
                "block min-w-0 max-w-full truncate py-0.5 text-sm text-muted-foreground transition-colors duration-200 ease-out hover:text-foreground",
                currentPath === `${href}/` || currentPath === href
                  ? "font-medium text-foreground!"
                  : "",
              ]}
            >
              {writingEntry.data.title}
            </a>
          )
        })
      }
    </div>
  </nav>
</aside>
